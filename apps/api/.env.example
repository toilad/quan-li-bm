# Copy to .env (never committed). Leave a value empty → the app shows "Chưa cấu hình" for that service.

# Database (Docker: set by docker-compose). Empty locally → embedded PostgreSQL in apps/api/.pgdata
DATABASE_URL=

# Google — service account JSON file; share the Sheet and the Drive folder with its client_email
GOOGLE_SERVICE_ACCOUNT_FILE=
SHEET_ID=
SHEET_TAB=Phoi US
DRIVE_FOLDER_ID=

# AI (Anthropic)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Per nick (n1, n2, n3 — see config/nicks.example.json)
INET_API_KEY_N1=
CPANEL_USER_N1=
CPANEL_TOKEN_N1=
INET_API_KEY_N2=
CPANEL_USER_N2=
CPANEL_TOKEN_N2=
INET_API_KEY_N3=
CPANEL_USER_N3=
CPANEL_TOKEN_N3=
