# Copy to .env (never committed). Leave a value empty → the app shows "Chưa cấu hình" for that service.

# Database (Docker: set by docker-compose). Empty locally → embedded PostgreSQL in apps/api/.pgdata
DATABASE_URL=

# Google — personal Gmail: OAuth of the owner. Create an OAuth client ("Desktop app") in Google Cloud,
# download its JSON, set the path below, then run:  python -m scripts.google_auth   (consent in the browser once)
GOOGLE_OAUTH_CLIENT_FILE=
# Optional alternative for Sheets / shared drives only:
GOOGLE_SERVICE_ACCOUNT_FILE=
SHEET_ID=
SHEET_TAB=Phoi US
# Empty → the app creates its own folder “Quản Lí BM — Phôi PDF” (drive.file scope only sees app-created files)
DRIVE_FOLDER_ID=

# AI (Anthropic)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Per nick (n1, n2, n3 — see config/nicks.example.json)
INET_API_KEY_N1=
CPANEL_USER_N1=
CPANEL_TOKEN_N1=
INET_API_KEY_N2=
CPANEL_USER_N2=
CPANEL_TOKEN_N2=
INET_API_KEY_N3=
CPANEL_USER_N3=
CPANEL_TOKEN_N3=
